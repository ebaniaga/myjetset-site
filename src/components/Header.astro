---
// Top bar — mirrors the search page's .topbar, plus nav links and the
// "Book a call" CTA (opens the Superhuman scheduling page in a new tab).
// Self-styled on purpose: it must look right on the search page, which does
// not load global.css.
import { SITE } from "../lib/site.js";

const { active } = Astro.props;
const links = [
  { href: "/search", label: "Award search", key: "search" },
  { href: "/about", label: "About", key: "about" },
  { href: "/inquiry", label: "Plan a trip", key: "inquiry" },
];
---
<nav class="topbar" aria-label="Primary">
  <div class="topbar-inner">
    <a class="topbar-brand" href="/">
      <svg class="topbar-mark" viewBox="0 0 30 30" aria-hidden="true"><path d="M15 2 L17.4 12.6 L28 15 L17.4 17.4 L15 28 L12.6 17.4 L2 15 L12.6 12.6 Z"/></svg>
      <span>{SITE.name}</span>
    </a>
    <div class="topbar-links">
      {links.map((l) => (
        <a href={l.href} aria-current={active === l.key ? "page" : undefined}>{l.label}</a>
      ))}
    </div>
    <a class="topbar-cta" href={SITE.bookUrl} target="_blank" rel="noopener">Book a call</a>
  </div>
</nav>

<style>
  .topbar { background: var(--emerald); }
  .topbar-inner {
    max-width: 1120px; margin: 0 auto; padding: 16px 24px;
    display: flex; align-items: center; gap: 28px; flex-wrap: wrap;
  }
  .topbar-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .topbar-mark { width: 20px; height: 20px; }
  .topbar-mark path { fill: var(--gold); }
  .topbar-brand span { font-family: var(--serif); font-style: italic; font-size: 22px; color: #F1EEE4; }
  .topbar-links { display: flex; gap: 24px; margin-left: 8px; }
  .topbar-links a {
    font-size: 13px; color: var(--cream-90); text-decoration: none;
    padding-bottom: 2px; border-bottom: 1px solid transparent; transition: color .15s ease;
  }
  .topbar-links a:hover { color: #F1EEE4; }
  .topbar-links a[aria-current="page"] { color: var(--gold); border-bottom-color: var(--gold); }
  .topbar-cta {
    margin-left: auto; display: inline-flex; align-items: center; white-space: nowrap;
    background: var(--gold); color: var(--emerald); text-decoration: none;
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600;
    padding: 11px 20px; border-radius: 6px; transition: filter .15s ease;
  }
  .topbar-cta:hover { filter: brightness(.94); }
  @media (max-width: 640px) {
    .topbar-inner { gap: 14px 20px; }
    .topbar-links { order: 3; width: 100%; margin-left: 0; gap: 18px; }
  }
</style>
