---
// Site footer: newsletter (Buttondown), links, contact. Self-styled so it renders
// correctly on the search page, which does not load global.css.
import { SITE } from "../lib/site.js";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="brand" href="/">
        <svg viewBox="0 0 30 30" aria-hidden="true"><path d="M15 2 L17.4 12.6 L28 15 L17.4 17.4 L15 28 L12.6 17.4 L2 15 L12.6 12.6 Z"/></svg>
        <span>{SITE.name}</span>
      </a>
      <p class="tagline">Attainable luxury, arranged quietly.<br/>Points and miles, spent beautifully.</p>
      <p class="contact"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>

    <div class="footer-links">
      <p class="eyebrow">Explore</p>
      <a href="/search">Award search</a>
      <a href="/about">About</a>
      <a href="/inquiry">Plan a trip</a>
      <a href={SITE.bookUrl} target="_blank" rel="noopener">Book a call</a>
      <a href={SITE.foraUrl} target="_blank" rel="noopener">Fora profile</a>
    </div>

    <div class="footer-news">
      <p class="eyebrow">Points tips &amp; travel notes</p>
      <p class="news-copy">Occasional dispatches — award sweet spots, transfer bonuses, places worth the miles. No noise.</p>
      <form action="https://buttondown.com/api/emails/embed-subscribe/myjetsetlife" method="post" target="_blank" class="news-form">
        <label class="sr-only" for="footer-email">Email address</label>
        <input id="footer-email" name="email" type="email" placeholder="you@email.com" autocomplete="email" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-inner">
      <span>© {year} {SITE.name} · {SITE.advisor}, Fora Travel Advisor</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--pine); color: var(--cream-90); font-family: var(--sans); margin-top: 0; }
  .footer-inner {
    max-width: 1120px; margin: 0 auto; padding: 56px 24px 40px;
    display: grid; grid-template-columns: 1.2fr .7fr 1.1fr; gap: 40px;
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand svg { width: 18px; height: 18px; }
  .brand svg path { fill: var(--gold); }
  .brand span { font-family: var(--serif); font-style: italic; font-size: 22px; color: #F1EEE4; }
  .tagline { margin: 14px 0 0; font-size: 14px; line-height: 1.6; color: var(--cream-90); }
  .contact { margin: 14px 0 0; font-size: 13px; }
  .contact a, .footer-links a { color: var(--cream-90); text-decoration: none; transition: color .15s ease; }
  .contact a:hover, .footer-links a:hover { color: var(--gold); }
  .eyebrow { margin: 0 0 14px; font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--gold); }
  .footer-links { display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  .news-copy { margin: 0 0 14px; font-size: 14px; line-height: 1.6; }
  .news-form { display: flex; gap: 8px; }
  .news-form input {
    flex: 1; min-width: 0; font-family: var(--sans); font-size: 14px; color: #F1EEE4;
    background: rgba(241,238,228,.06); border: 1px solid rgba(241,238,228,.22);
    border-radius: 6px; padding: 11px 13px;
  }
  .news-form input::placeholder { color: rgba(205,214,207,.6); }
  .news-form input:focus { outline: none; border-color: var(--gold); }
  .news-form button {
    font-family: var(--sans); font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    font-weight: 600; color: var(--emerald); background: var(--gold); border: none;
    border-radius: 6px; padding: 11px 18px; cursor: pointer; white-space: nowrap; transition: filter .15s ease;
  }
  .news-form button:hover { filter: brightness(.94); }
  .footer-bottom { border-top: 1px solid rgba(241,238,228,.16); }
  .footer-bottom .footer-inner { display: block; padding: 18px 24px; font-size: 12px; color: rgba(205,214,207,.7); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 760px) {
    .footer-inner { grid-template-columns: 1fr; gap: 32px; padding: 40px 20px 32px; }
  }
</style>
