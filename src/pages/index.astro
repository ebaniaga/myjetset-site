---
import Layout from "../layouts/Layout.astro";
import Star from "../components/Star.astro";
import "../styles/global.css";
import { SITE } from "../lib/site.js";
---
<Layout
  title="My Jet Set Life — Travel advisory, miles & points optimization"
  description="Attainable luxury, arranged quietly. Fora travel advisor Erickson Baniaga turns points and miles into premium cabins and partner-rate stays."
  active="home"
>

  <!-- Hero -->
  <section class="hero section--emerald">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow eyebrow--gold">Fora Travel Advisor · {SITE.location}</p>
        <h1 class="display-xl">Attainable luxury, <em>arranged quietly.</em></h1>
        <p class="body-l hero-lead">Points and miles turned into premium cabins and partner-rate suites — planned by a travel advisor who has been to all seven continents and more than fifty countries.</p>
        <div class="row hero-ctas">
          <a class="btn btn--accent btn--lg" href={SITE.bookUrl} target="_blank" rel="noopener">Book a call</a>
          <a class="btn btn--ghost-dark btn--lg" href="/search">Search award flights</a>
        </div>
      </div>
      <div class="photo photo--4x5 hero-photo">
        <img src="/images/antarctica-1.jpg" alt="An iceberg with a blue ice cave, Antarctic Peninsula" width="1350" height="1800" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">What I do</p>
      <h2 class="display-m">Three ways to travel better.</h2>
      <div class="grid-3 services">
        <article class="card">
          <Star size={26} />
          <h3 class="card__title">Trip planning &amp; booking</h3>
          <p class="card__body">Hotels, itineraries and the small details, booked through Fora. Partner properties come with perks — breakfast, upgrades when available, resort credits, early check-in and late checkout — at no extra cost to you.</p>
          <a class="btn btn--link" href="/inquiry">Plan a trip →</a>
        </article>
        <article class="card">
          <Star size={26} />
          <h3 class="card__title">Miles &amp; points optimization</h3>
          <p class="card__body">Sitting on a balance you're not sure how to use? I'll map the best redemptions for the trip you actually want — premium cabins, partner awards, transfer bonuses and sweet spots.</p>
          <a class="btn btn--link" href="/search">Search award flights →</a>
        </article>
        <article class="card">
          <Star size={26} />
          <h3 class="card__title">Travel protection</h3>
          <p class="card__body">The right coverage for the trip you're taking — medical, cancellation, and the fine print most people skip. I'll help you choose what actually fits.</p>
          <a class="btn btn--link" href="/inquiry">Ask about protection →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- What your points can do -->
  <section class="section--tight points">
    <div class="container">
      <p class="eyebrow">What your points can do</p>
      <h2 class="display-m">The seats miles are made for.</h2>
      <p class="body-l soft points-lead">I've flown these cabins on points. Let me help you do the same.</p>
      <div class="grid-3 points-grid">
        <div class="photo photo--square">
          <img src="/images/ana-first-suite.jpg" alt="ANA First Class suite on the A380 Flying Honu" width="1800" height="1350" loading="lazy" />
          <div class="overlay"><div class="kicker">ANA · First Class</div><div class="caption">Honolulu → Tokyo, seat 2K</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/ana-first-krug.jpg" alt="A bottle of Krug and a flute in ANA First Class" width="1350" height="1800" loading="lazy" />
          <div class="overlay"><div class="kicker">ANA · First Class</div><div class="caption">Krug, poured before pushback</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/ana-first-me.jpg" alt="Erickson settled into his ANA First Class suite" width="1350" height="1800" loading="lazy" />
          <div class="overlay"><div class="kicker">ANA · First Class</div><div class="caption">Settled in</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/qatar-first-suite.jpg" alt="Qatar Airways A380 First Class suite" width="1350" height="1800" loading="lazy" />
          <div class="overlay"><div class="kicker">Qatar Airways · First Class</div><div class="caption">The A380 suite</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/qatar-first-bar.jpg" alt="The onboard bar on the Qatar Airways A380" width="1350" height="1800" loading="lazy" />
          <div class="overlay"><div class="kicker">Qatar Airways · First Class</div><div class="caption">The onboard bar</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/qatar-first-bar-me.jpg" alt="Erickson at the onboard bar of the Qatar Airways A380 with a tasting flight" width="1350" height="1800" loading="lazy" />
          <div class="overlay"><div class="kicker">Qatar Airways · First Class</div><div class="caption">A tasting flight at the bar</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/qatar-qsuite-bed.jpg" alt="Qatar Airways Qsuite made up as a bed" width="1800" height="1350" loading="lazy" />
          <div class="overlay"><div class="kicker">Qatar Airways · Qsuite</div><div class="caption">Business class with a door — and a bed</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/singapore-business-seat.jpg" alt="Singapore Airlines business class seat by the window" width="1350" height="1800" loading="lazy" />
          <div class="overlay"><div class="kicker">Singapore Airlines · Business</div><div class="caption">Seat and window</div></div>
        </div>
        <div class="photo photo--square">
          <img src="/images/ba-club-suite.jpg" alt="British Airways Club Suite made up for the night" width="1800" height="1350" loading="lazy" />
          <div class="overlay"><div class="kicker">British Airways · Club Suite</div><div class="caption">Made up for the night</div></div>
        </div>
      </div>
      <p class="points-hint">Swipe →</p>
      <div class="row points-ctas">
        <a class="btn btn--primary" href="/search">Search award flights</a>
        <a class="btn btn--link" href="/inquiry">Ask me how →</a>
      </div>
    </div>
  </section>

  <!-- Award search teaser -->
  <section class="section--tight">
    <div class="container">
      <div class="panel framed teaser">
        <div class="teaser-copy">
          <p class="eyebrow">Award search</p>
          <h2 class="serif-l">See what your points can do.</h2>
          <p class="soft">Enter your balance, programs and dates. I'll search award availability and email you the options — real seats, real prices in points.</p>
        </div>
        <a class="btn btn--accent btn--lg" href="/search">Search award flights</a>
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section section--emerald">
    <div class="container about-grid">
      <div class="photo photo--4x5 about-photo">
        <img src="/images/erickson.jpg" alt="Erickson Baniaga" width="1200" height="1500" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow eyebrow--gold">About</p>
        <h2 class="display-m">Digital nomad. Seven continents. Fifty-plus countries.</h2>
        <p class="body-l about-lead">I'm Erickson — a Fora travel advisor based in {SITE.location}. I enjoy it all, from home stays to high-end hotels, adventure excursions to all-inclusives. What I'm really after is new experiences and connections everywhere I go, and I'd love to help you find yours.</p>
        <a class="btn btn--link btn--link-light" href="/about">More about Erickson →</a>
      </div>
    </div>
  </section>

  <!-- From the road -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">From the road</p>
      <div class="grid-3 road">
        <div class="photo photo--3x2">
          <img src="/images/budapest-1.jpg" alt="Hungarian Parliament lit gold at blue hour, from the Danube" width="1800" height="1350" loading="lazy" />
          <div class="overlay"><div class="kicker">Hungary</div><div class="caption">Budapest at blue hour</div></div>
        </div>
        <div class="photo photo--3x2">
          <img src="/images/leh-1.jpg" alt="Snow-covered Ladakh range under a clear sky" width="1800" height="1350" loading="lazy" />
          <div class="overlay"><div class="kicker">Ladakh, India</div><div class="caption">Leh in January</div></div>
        </div>
        <div class="photo photo--3x2">
          <img src="/images/honolulu-1.jpg" alt="Makapuʻu coastline, Oʻahu" width="1800" height="1350" loading="lazy" />
          <div class="overlay"><div class="kicker">Hawaiʻi</div><div class="caption">Makapuʻu, Oʻahu</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section section--pine">
    <div class="container cta">
      <h2 class="display-m">Ready when you are.</h2>
      <p class="body-l cta-lead">Tell me about the trip, or grab a few minutes on my calendar and we'll talk it through.</p>
      <div class="row cta-row">
        <a class="btn btn--accent btn--lg" href="/inquiry">Plan a trip</a>
        <a class="btn btn--ghost-dark btn--lg" href={SITE.bookUrl} target="_blank" rel="noopener">Book a call</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero { padding: 88px 0; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
  .hero h1 { color: var(--cream); margin-top: 18px; }
  .hero h1 em { font-style: italic; font-weight: 400; color: var(--gold); }
  .hero-lead { margin-top: 22px; max-width: 46ch; }
  .hero-ctas { margin-top: 34px; }
  .hero-photo { box-shadow: var(--shadow-raised); }

  .services { margin-top: 40px; }
  .services .card { display: flex; flex-direction: column; }
  .services :global(.star) { margin-bottom: 14px; }
  .services .card__body { flex: 1; }
  .services .btn--link { align-self: flex-start; margin-top: 18px; }

  .teaser { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .teaser-copy { max-width: 560px; }
  .teaser .serif-l { color: var(--emerald); margin-top: 10px; }
  .teaser .soft { margin-top: 10px; }

  .about-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: center; }
  .about-photo { max-width: 420px; box-shadow: var(--shadow-raised); }
  .about-lead { margin-top: 18px; max-width: 52ch; }
  .about-grid .btn--link { margin-top: 26px; }
  .about-grid .display-m { margin-top: 14px; }

  .road { margin-top: 24px; }

  .points { padding-top: 0; }
  .points .display-m { margin-top: 12px; }
  .points-lead { margin-top: 10px; max-width: 52ch; text-wrap: balance; }
  .points-grid { margin-top: 28px; }
  .points-ctas { margin-top: 28px; gap: 22px; }
  .points-hint { display: none; margin-top: 12px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--sage); }
  /* Phones: a swipe carousel instead of nine stacked squares. Desktop keeps the grid. */
  @media (max-width: 760px) {
    .points-grid {
      display: flex; gap: 12px; margin: 24px -20px 0; padding: 0 20px 6px;
      overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 20px;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    .points-grid::-webkit-scrollbar { display: none; }
    .points-grid > .photo { flex: 0 0 78%; scroll-snap-align: start; }
    .points-hint { display: block; }
  }

  .cta { text-align: center; }
  .cta-lead { margin: 14px auto 0; max-width: 46ch; }
  .cta-row { justify-content: center; margin-top: 30px; }

  @media (max-width: 860px) {
    .hero { padding: 56px 0; }
    .hero-grid, .about-grid { grid-template-columns: 1fr; gap: 32px; }
    .hero-photo { max-width: 460px; }
    .teaser { flex-direction: column; align-items: flex-start; }
  }
</style>
