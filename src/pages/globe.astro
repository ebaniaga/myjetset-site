---
// The globe: every place I've been as a gold pin on a 3D globe, with photos,
// a story, and (when there is one) a link to the blog post. "Spin the globe"
// lands on a random pin. Pins come from src/data/places.js — edit that file
// to add places; nothing here needs to change.
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { PLACES, placeStats, markerType } from "../data/places.js";
import { THUMBNAIL_WIDTHS, thumbnailUrl } from "../lib/thumbnails.js";

const stats = placeStats(PLACES);
const continents = [...new Set(PLACES.map((p) => p.continent))].sort();
const byContinent = continents.map((c) => {
  const here = PLACES.filter((p) => p.continent === c);
  return {
    name: c,
    cards: here.filter((p) => markerType(p) !== "visit"),
    dots: groupByCountry(here.filter((p) => markerType(p) === "visit")),
  };
});
/** [{ country, places }] — country label is the last comma-part of `place`. */
function groupByCountry(list) {
  const m = new Map();
  for (const p of list) {
    const k = p.place.split(", ").pop();
    if (!m.has(k)) m.set(k, []);
    m.get(k).push(p);
  }
  return [...m].map(([country, places]) => ({ country, places }));
}
---
<Layout
  title="The Globe — Where I've Been · My Jet Set Life"
  description="Every pin is a place I've actually been — seven continents, fifty-plus countries. Give it a spin and land somewhere new."
  ogImage="/images/og-globe.jpg"
  active="globe"
>

<section class="globe-hero">
  <div class="globe-head container">
    <div>
      <p class="eyebrow eyebrow--gold">The globe</p>
      <h1 class="display-l">Where I've been.</h1>
      <p class="body-l globe-lead">Every dot is somewhere I've been. Gold pins have photos and stories; cream pins are the places that made me. Drag to explore, tap anything — or let the globe choose for you.</p>
      <ul class="globe-key" aria-label="Map key">
        <li><span class="key key--visit"></span>Been there</li>
        <li><span class="key key--story"></span>Photos &amp; stories</li>
        <li><span class="key key--special"></span>Home &amp; roots</li>
      </ul>
    </div>
    <dl class="globe-stats" aria-label="Travel stats">
      <div><dt>Continents</dt><dd data-count={stats.continents}>{stats.continents}</dd></div>
      <div><dt>Countries</dt><dd data-count={stats.countries}>{stats.countries}</dd></div>
      <div><dt>Places</dt><dd data-count={stats.places}>{stats.places}</dd></div>
    </dl>
  </div>

  <div class="globe-stage" id="globe-stage">
    <div class="globe-canvas" id="globe" aria-label="Interactive 3D globe of places Erickson has visited" role="img"></div>

    <!-- Static poster shown until the 3D globe module is fetched. -->
    <div class="globe-poster" id="globe-poster">
      <img src="/images/globe-poster.jpg" alt="" width="940" height="865" loading="eager" decoding="async" />
      <button class="btn btn--accent globe-load" id="globe-load" type="button">Explore the 3D globe</button>
    </div>

    <button class="btn btn--accent spin-btn" id="spin" type="button" hidden>
      <svg width="14" height="14" viewBox="0 0 30 30" aria-hidden="true"><path d="M15 2 L17.4 12.6 L28 15 L17.4 17.4 L15 28 L12.6 17.4 L2 15 L12.6 12.6 Z" fill="currentColor"/></svg>
      Inspire me
    </button>
    <p class="globe-hint" id="hint" hidden>Drag to rotate · scroll to zoom</p>

    <!-- Place panel: filled by the script when a pin is chosen -->
    <aside class="place-panel" id="panel" hidden aria-live="polite">
      <div class="place-panel__inner framed">
        <button class="panel-close sr-only" id="panel-close" type="button">Close</button>
        <div class="place-photos" id="photos">
          <div class="strip" id="strip" aria-label="Photos"></div>
          <p class="strip-hint" id="strip-hint" hidden>Swipe →</p>
        </div>
        <div class="place-body">
          <p class="eyebrow eyebrow--gold" id="place-kicker"></p>
          <h2 class="serif-l" id="place-name"></h2>
          <p class="place-blurb" id="place-blurb"></p>
          <div class="row place-actions">
            <a class="btn btn--accent btn--sm" id="place-blog" href="#" hidden>Read the story →</a>
            <a class="btn btn--ghost-dark btn--sm" id="place-plan" href="/inquiry">Plan a trip like this</a>
          </div>
          <p class="place-back">Tap the globe to go back</p>
        </div>
      </div>
    </aside>

    <noscript>
      <p class="globe-noscript">The 3D globe needs JavaScript. The full list of places is just below.</p>
    </noscript>
  </div>
</section>

<!-- Every pin, as a plain list: the accessible fallback and the blog index. -->
<section class="section pins">
  <div class="container">
    <p class="eyebrow">Every pin</p>
    <h2 class="display-m">By continent.</h2>
    {byContinent.map((c) => (
      <div class="pin-group">
        <h3 class="serif-m pin-continent">{c.name}</h3>
        <ul class="pin-list">
          {c.cards.map((p) => (
            <li class="pin-item">
              <button class="pin-card" type="button" data-place={p.id}>
                {p.photos[0]
                  ? <img class="pin-thumb" src={thumbnailUrl(p.photos[0].src, 160)}
                      srcset={THUMBNAIL_WIDTHS.map((w) => `${thumbnailUrl(p.photos[0].src, w)} ${w}w`).join(", ")}
                      sizes="80px" alt="" width="160" height="108" loading="lazy" decoding="async" />
                  : <span class="pin-thumb pin-thumb--empty" aria-hidden="true" />}
                <span class="pin-text">
                  <span class="pin-place">{p.place}{p.when ? ` · ${p.when}` : ""}</span>
                  <span class="pin-name">{p.name}</span>
                </span>
              </button>
              {p.blog && <a class="pin-blog" href={p.blog}>Read the story →</a>}
            </li>
          ))}
        </ul>
        {c.dots.length > 0 && (
          <dl class="pin-dots">
            {c.dots.map((g) => (
              <div class="pin-dots__row">
                <dt>{g.country}</dt>
                <dd>{g.places.map((p) => <button class="dot-link" type="button" data-place={p.id}>{p.name}</button>)}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    ))}
  </div>
</section>

<section class="section section--pine">
  <div class="container cta">
    <h2 class="display-m">Want your own pin?</h2>
    <p class="body-l cta-lead">Tell me where you've been dreaming about and I'll get you there — on points, in a premium cabin, with the good hotel.</p>
    <div class="row cta-row">
      <a class="btn btn--accent btn--lg" href="/inquiry">Plan a trip</a>
      <a class="btn btn--ghost-dark btn--lg" href="/search">Search award flights</a>
    </div>
  </div>
</section>

</Layout>

<script>
  import { PLACES } from "../data/places.js";

  const stage = document.getElementById("globe-stage")!;
  const poster = document.getElementById("globe-poster")!;
  const loadBtn = document.getElementById("globe-load") as HTMLButtonElement;
  const spinBtn = document.getElementById("spin") as HTMLButtonElement;
  const hint = document.getElementById("hint")!;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The 3D globe (globe.gl + three, ~2 MB) is fetched on demand. Desktops get it
  // as soon as the stage scrolls near the viewport; phones and data-saver
  // connections keep the static poster until the visitor asks for it.
  type GlobeApi = ReturnType<typeof import("../lib/globe-app")["initGlobe"]>;
  let loading: Promise<GlobeApi> | null = null;
  function load(): Promise<GlobeApi> {
    if (!loading) {
      poster.classList.add("is-loading");
      loadBtn.disabled = true;
      loadBtn.textContent = "Loading the globe…";
      loading = import("../lib/globe-app").then((m) => {
        const api = m.initGlobe();
        poster.remove();
        spinBtn.hidden = false;
        hint.hidden = false;
        return api;
      });
      loading.catch(() => {
        poster.classList.remove("is-loading");
        loadBtn.disabled = false;
        loadBtn.textContent = "Couldn't load the globe — try again";
      });
    }
    return loading;
  }

  const lite = matchMedia("(max-width: 760px), (pointer: coarse)").matches || (navigator as any).connection?.saveData === true;
  if (!lite) {
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { o.disconnect(); load(); } }, { rootMargin: "300px" }).observe(stage);
  }
  loadBtn.addEventListener("click", () => load());
  spinBtn.addEventListener("click", () => load().then((api) => api.spin()));

  // The list below the globe doubles as an index: click a card to fly there.
  const known = new Set(PLACES.map((p) => p.id));
  document.querySelectorAll<HTMLButtonElement>("[data-place]").forEach((b) => {
    b.addEventListener("click", () => {
      const id = b.dataset.place!;
      if (!known.has(id)) return;
      stage.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
      load().then((api) => api.goTo(id));
    });
  });

  // Header stats count up from zero on load.
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((dd, i) => {
      const target = Number(dd.dataset.count);
      const dur = 1200 + i * 150;
      const t0 = performance.now();
      dd.textContent = "0";
      const tick = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        dd.textContent = String(Math.round(target * eased));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>

<style is:global>
  /* ── Hero + stage ─────────────────────────────────────────────────────── */
  .globe-hero [hidden] { display: none !important; }
  .globe-hero { background: var(--emerald); color: var(--cream-90); overflow: hidden; }
  .globe-head {
    display: grid; grid-template-columns: 1.3fr .7fr; gap: 40px; align-items: center;
    padding-top: 64px; padding-bottom: 48px;
  }
  .globe-head h1 { color: var(--cream); margin-top: 12px; }
  .globe-lead { margin-top: 18px; max-width: 52ch; }
  .globe-key { list-style: none; margin: 18px 0 0; padding: 0; display: flex; gap: 22px; flex-wrap: wrap; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: rgba(241,238,228,.7); }
  .globe-key li { display: inline-flex; align-items: center; gap: 8px; }
  .key { display: inline-block; width: 12px; height: 12px; }
  .key--visit { width: 7px; height: 7px; border-radius: 50%; background: var(--pine); box-shadow: 0 0 0 1.5px rgba(241,238,228,.7); }
  .key--story { background: var(--gold); clip-path: polygon(50% 0, 58% 42%, 100% 50%, 58% 58%, 50% 100%, 42% 58%, 0 50%, 42% 42%); }
  .key--special { background: var(--cream); clip-path: polygon(50% 0, 58% 42%, 100% 50%, 58% 58%, 50% 100%, 42% 58%, 0 50%, 42% 42%); }
  .globe-stats { margin: 0; display: flex; gap: 36px; justify-content: flex-end; }
  .globe-stats dt { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--gold); }
  .globe-stats dd { margin: 2px 0 0; font-family: var(--serif); font-size: 44px; line-height: 1.1; color: var(--cream); font-variant-numeric: tabular-nums; }

  .globe-stage {
    position: relative; height: min(78vh, 760px); min-height: 480px;
    background: radial-gradient(ellipse at 50% 60%, #1a4f41 0%, var(--emerald) 45%, var(--pine) 100%);
  }
  /* Keep the renderer's per-pin z-indexes below the destination card and controls. */
  .globe-canvas { position: absolute; inset: 0; z-index: 0; cursor: grab; }
  .globe-poster { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; }
  .globe-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: center; opacity: .9; }
  .globe-poster .globe-load { position: relative; z-index: 1; }
  .globe-poster.is-loading .globe-load { opacity: .7; }
  .globe-canvas:active { cursor: grabbing; }
  .globe-canvas canvas { outline: none; }

  .spin-btn {
    position: absolute; top: 20px; right: 20px; z-index: 3;
    pointer-events: auto; box-shadow: 0 10px 34px rgba(8,30,24,.45);
  }
  .globe-hint {
    position: absolute; left: 0; right: 0; bottom: 24px; z-index: 3; text-align: center;
    pointer-events: none; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: rgba(241,238,228,.55);
  }
  /* When a place card is open, the corner button and hint step aside. */
  .has-panel .spin-btn, .has-panel .globe-hint { display: none; }
  .globe-noscript { position: absolute; inset: auto 0 50%; text-align: center; color: var(--cream); padding: 0 20px; }

  /* ── Pins (DOM markers on the globe) ──────────────────────────────────── */
  .pin {
    position: relative; width: 28px; height: 28px; padding: 0; margin: 0;
    background: none; border: 0; cursor: pointer; pointer-events: auto;
    display: grid; place-items: center; color: var(--gold);
    filter: drop-shadow(0 0 6px rgba(227,195,110,.7));
    transition: transform .18s ease;
    opacity: 0; animation: pin-in .3s ease .5s forwards; /* wait for the first frames to place it */
  }
  @keyframes pin-in { to { opacity: 1; } }
  .pin svg { width: 16px; height: 16px; }
  .pin svg path { fill: currentColor; }
  .pin::before {
    content: ""; position: absolute; width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid rgba(227,195,110,.55); opacity: 0;
  }
  /* Only the pin you land on radiates; every other star just sits there. */
  .pin.is-active::before { opacity: 1; animation: pin-pulse 2.6s ease-out infinite; }
  .pin:hover, .pin:focus-visible, .pin.is-active { transform: scale(1.25); }
  .pin:focus-visible { outline: 2px solid var(--cream); outline-offset: 4px; border-radius: 50%; }
  .pin--special { color: var(--cream); filter: drop-shadow(0 0 6px rgba(241,238,228,.6)); }
  .pin--special svg { width: 18px; height: 18px; }
  .pin--special::before { border-color: rgba(241,238,228,.5); animation: none; }
  /* Hover tooltip for the WebGL dots (globe.gl's built-in tooltip element). */
  .globe-canvas .scene-tooltip { font-family: var(--serif) !important; font-size: 15px !important; color: var(--cream) !important; text-shadow: 0 1px 6px rgba(8,30,24,.9); }
  .pin__label {
    position: absolute; top: 100%; left: 50%; transform: translate(-50%, 4px);
    font-family: var(--serif); font-size: 15px; white-space: nowrap; color: var(--cream);
    opacity: 0; pointer-events: none; transition: opacity .15s ease;
    text-shadow: 0 1px 6px rgba(8,30,24,.9);
  }
  .pin:hover .pin__label, .pin:focus-visible .pin__label { opacity: 1; }
  @media (max-width: 760px), (pointer: coarse) {
    .pin svg { width: 11px; height: 11px; }
    .pin--special svg { width: 13px; height: 13px; }
    .pin { filter: drop-shadow(0 0 4px rgba(227,195,110,.6)); }
  }
  @keyframes pin-pulse { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(1.9); opacity: 0; } }

  /* ── Place panel ──────────────────────────────────────────────────────── */
  .place-panel {
    position: absolute; top: 24px; right: 24px; bottom: 24px; width: min(400px, calc(100% - 48px)); z-index: 4;
    display: flex; align-items: flex-start;
  }
  .place-panel__inner {
    position: relative; width: 100%; max-height: 100%; overflow: auto;
    background: var(--pine); color: var(--cream-90);
    border-radius: var(--radius-card); box-shadow: var(--shadow-raised);
    padding: 24px; animation: panel-in .35s ease;
  }
  .place-panel__inner::before { inset: 10px; }
  @keyframes panel-in { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: none; } }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .panel-close:focus-visible { position: absolute; top: 12px; right: 12px; width: auto; height: auto; margin: 0; padding: 8px 12px; clip: auto; z-index: 2; background: var(--gold); color: var(--emerald); border-radius: 4px; font-size: 12px; }
  .place-back { margin-top: 18px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: rgba(241,238,228,.45); }
  /* Keep the scrollable filmstrip inside the card's padded gold frame. */
  .strip {
    --strip-h: 240px;
    display: flex; gap: 10px; height: var(--strip-h);
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
    margin: 0; padding: 0; scroll-padding: 0;
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip[hidden] { display: none; }
  .slide { position: relative; flex: 0 0 auto; height: 100%; margin: 0; border-radius: var(--radius-card); overflow: hidden; scroll-snap-align: start; background: rgba(241,238,228,.06); }
  .slide img { display: block; height: 100%; width: auto; max-width: 86vw; }
  .slide::before { content: ""; position: absolute; inset: 10px; border: var(--frame-strong); border-radius: var(--radius-inner); pointer-events: none; z-index: 1; }
  .strip-hint { margin: 8px 0 0; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgba(241,238,228,.45); }
  .strip-hint[hidden] { display: none; }
  .place-body { margin-top: 18px; }
  .place-body .serif-l { color: var(--cream); margin-top: 8px; }
  .place-blurb { margin-top: 12px; font-size: 14px; line-height: 1.65; }
  .place-actions { margin-top: 20px; gap: 10px; }

  /* ── Pin index ────────────────────────────────────────────────────────── */
  .pins .display-m { color: var(--emerald); margin-top: 10px; }
  .pin-group { margin-top: 40px; }
  .pin-continent { color: var(--emerald); padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .pin-list { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pin-item { display: flex; flex-direction: column; }
  .pin-card {
    display: flex; gap: 14px; align-items: center; text-align: left; width: 100%;
    padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-card);
    cursor: pointer; transition: border-color .15s ease, box-shadow .15s ease;
  }
  .pin-card:hover { border-color: var(--gold); box-shadow: var(--shadow-card); }
  .pin-thumb { width: 80px; height: 54px; object-fit: cover; border-radius: var(--radius-inner); flex: none; }
  .pin-thumb--empty { display: block; background: linear-gradient(200deg, var(--verde), var(--pine) 78%); }
  .pin-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pin-place { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--meta); }
  .pin-name { font-family: var(--serif); font-size: 20px; color: var(--emerald); line-height: 1.15; }
  .pin-dots { margin: 20px 0 0; display: grid; gap: 8px; }
  .pin-dots__row { display: grid; grid-template-columns: 150px 1fr; gap: 12px; padding-top: 8px; border-top: 1px solid var(--line); font-size: 14px; line-height: 1.9; }
  .pin-dots__row dt { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--meta); font-weight: 600; padding-top: 5px; }
  .pin-dots__row dd { margin: 0; color: var(--ink-soft); }
  .dot-link { font: inherit; background: none; border: 0; padding: 0 0 1px; margin-right: 14px; color: var(--emerald); cursor: pointer; border-bottom: 1px solid var(--line); }
  .dot-link:hover { border-color: var(--gold); }
  .pin-blog { align-self: flex-start; margin: 8px 0 0 12px; font-size: 13px; color: var(--emerald); text-decoration: none; border-bottom: 1px solid var(--emerald); }
  .pin-blog:hover { color: var(--verde); border-color: var(--verde); }

  .cta { text-align: center; }
  .cta-lead { margin: 14px auto 0; max-width: 52ch; }
  .cta-row { justify-content: center; margin-top: 28px; }

  @media (max-width: 860px) {
    .globe-head { grid-template-columns: 1fr; gap: 28px; padding-top: 44px; padding-bottom: 36px; }
    .globe-stats { justify-content: flex-start; gap: 24px; }
    .globe-stats dd { font-size: 34px; }
    .globe-stage { height: 78vh; min-height: 520px; }
    .place-panel { top: auto; right: 12px; left: 12px; bottom: 12px; width: auto; max-height: 67%; }
    .strip { --strip-h: 220px; }
    .place-panel__inner { padding: 16px; }
    .place-panel__inner::before { inset: 7px; }
    .place-body { margin-top: 12px; }
    .place-body .serif-l { font-size: 24px; }
    .place-blurb { margin-top: 8px; font-size: 13px; }
    .place-actions { margin-top: 14px; }
    .place-back { margin-top: 10px; }
    .place-panel__inner { animation-name: panel-up; }
    @keyframes panel-up { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    .pin-list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .pin-list { grid-template-columns: 1fr; }
    .pin-dots__row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
